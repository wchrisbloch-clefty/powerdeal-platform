# ═══════════════════════════════════════════════════════
# PowerDeal Platform — environment
#
# Copy to .env.local. EVERY VARIABLE IS OPTIONAL.
# The app boots and is usable with this file completely empty — it runs on
# template data with no AI and no persistence. Each key below turns on a
# specific capability; the comment says exactly what you lose without it.
# ═══════════════════════════════════════════════════════

# ── Supabase ──
# Without these: template pipeline, nothing persists.
NEXT_PUBLIC_SUPABASE_URL=
#
# SERVICE ROLE — REQUIRED for any real data.
# There is no sign-in: this deployment is single-user behind Vercel SSO, so
# every read and write runs as the service role, scoped in code to
# POWERDEAL_USER_ID (lib/supabase/admin.ts). RLS policies are still on every
# table; they are just not consulted on this path.
#
# This key bypasses ALL access control in the database. Server-side only.
# NEVER prefix it with NEXT_PUBLIC_ and never send it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
#
# Anon key is no longer used by the app — nothing signs in. Kept here only
# because restoring auth would need it again.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── APPLICATION PASSWORD (REQUIRED) ──
# The app'''s own auth gate. One operator, one shared password, signed cookie.
#
# ⚠️ IT FAILS CLOSED. Unset means EVERY request is refused, including yours —
# an auth layer that disables itself when unconfigured is not an auth layer.
# Set this BEFORE deploying, or the deployment will refuse you too.
#
# This exists because a hosting toggle was the only thing in front of the data:
# Vercel Standard Protection covers deployment URLs and not the production
# alias, and Password Protection is Pro-gated. Rotate it to revoke every
# outstanding session at once.
APP_PASSWORD=

# ── AI providers ──
# Add in any order; the router uses whatever is present.
# GROQ: free and fast — feed summaries. console.groq.com
GROQ_API_KEY=
# GEMINI: free tier — mid-tier tasks, market watch. aistudio.google.com
GOOGLE_AI_KEY=
# ANTHROPIC: domain reasoning. Without it, brief/plan/qualify/MAP/outreach/
# chat are DISABLED — they are never routed to a cheaper model.
#
# It is ALSO the last link in the summarize and classify chains
# (groq → gemini → claude). Without it those two are two free tiers deep with
# nothing behind them, and on 2026-08-14 both free tiers failed in the same
# hour. Treat it as required, not optional.
ANTHROPIC_API_KEY=

# ── Model overrides ──
# Change a model here, never in lib/engine/model-routing.ts.
#
# WHICH IDS EXIST IS A FACT ABOUT SOMEONE ELSE'S SERVER. No test in this repo
# can check it. GET /api/models/health asks each provider's live API whether
# the configured id still resolves, and prints what is on offer when it does
# not. Check it after any provider announcement.
#
# gemini-2.0-flash was RETIRED — hard 404, "no longer available". The default
# moved to gemini-2.5-flash. Nothing auto-selects a replacement: a silently
# swapped model is a quality change nobody approved.
# ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5
# ANTHROPIC_MODEL_QUALITY=claude-sonnet-5
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash

# ── Feed relay (optional) ──
# thundersaidenergy.com 403s every request from Vercel's IP ranges — Cloudflare,
# IP-based, not user-agent based. workers/feed-relay.js is a Cloudflare Worker on
# an address it does not block. See workers/README.md.
#
# BOTH are required. A URL with no token is an unauthenticated URL-taking fetch
# endpoint, which is an open proxy — half-configured is treated as not
# configured rather than falling back to it.
# FEED_RELAY_URL=
# FEED_RELAY_TOKEN=

# ── Data + maps (all free) ──
# EIA: rate data and the pricing map. Without it, rates show "—".
# Free key: https://www.eia.gov/opendata/register.php
EIA_API_KEY=
# PowerOutage.us: live outage layer. Without it, the layer is hidden.
POWEROUTAGE_API_KEY=
# CO2 pipeline GeoJSON. Needs an NETL EDX export — see
# app/api/geo/co2-pipelines/route.ts. Layer is empty without it.
CO2_PIPELINES_URL=

# ── Social ──
# YouTube Data API v3, 10k units/day free. Without it, video search is skipped.
YOUTUBE_API_KEY=

# ── Payments (when ready to bill) ──
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Cron security ──
# Gates scheduled sweeps. Generate: openssl rand -hex 32
# UNSET MEANS DENY — cron routes reject every request rather than opening up.
# Set the same value on the Supabase edge functions.
CRON_SECRET=

# ── Deployment ──
# Absolute URL of this deployment. The market-watch edge function calls back
# into /api/feed/sweep, so it needs to know where the app lives.
APP_URL=

# ── Vertical ──
# Which config in lib/verticals/ to load. Defaults to powerdeal.
# NEXT_PUBLIC_VERTICAL_ID=powerdeal
